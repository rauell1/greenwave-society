generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  interest  String   @default("general")
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([interest])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model ExecutiveLeader {
  id         String                  @id @default(cuid())
  name       String
  role       String
  email      String                  @unique
  createdAt  DateTime                @default(now())
  signatures ConstitutionSignature[]

  @@map("executive_leaders")
}

model ConstitutionVersion {
  id          String                  @id @default(cuid())
  versionTag  String
  title       String                  @default("Executive Leadership Constitution")
  content     String                  @db.Text
  contentType String                  @default("html")
  status      String                  @default("draft")
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  signatures  ConstitutionSignature[]

  @@index([status])
  @@map("constitution_versions")
}

model ConstitutionSignature {
  id              String               @id @default(cuid())
  leaderId        String
  leader          ExecutiveLeader      @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  versionId       String?
  version         ConstitutionVersion? @relation(fields: [versionId], references: [id])
  versionTag      String               @default("V1")
  status          String               @default("pending")
  token           String               @unique
  signedAt        DateTime?
  rejectionReason String?
  ipAddress       String?
  emailSentAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([leaderId])
  @@index([token])
  @@index([status])
  @@map("constitution_signatures")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model MemberRegistration {
  id               String           @id @default(cuid())
  fullName         String
  email            String
  phone            String
  county           String
  occupation       String
  organization     String?
  meetsEligibility Boolean          @default(true)
  interests        String[]
  motivation       String           @db.Text
  hearAboutUs      String?
  source           String?
  acknowledged     Boolean          @default(true)
  status           String           @default("pending")
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedBy       String?
  memberToken      String?          @unique
  lastSeenAt       DateTime?
  loginCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  activity         MemberActivity[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([memberToken])
  @@map("member_registrations")
}

model MemberActivity {
  id             String             @id @default(cuid())
  registrationId String
  member         MemberRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event          String
  metadata       String?
  createdAt      DateTime           @default(now())

  @@index([registrationId])
  @@index([createdAt])
  @@map("member_activity")
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([resetToken])
  @@map("admin_users")
}

model ConsentLog {
  id               String   @id @default(cuid())
  consentId        String   @unique
  categories       String   // JSON string of enabled categories (necessary, analytics, marketing, preferences)
  ipHash           String?
  countryCode      String?  @default("GLOBAL")
  consentType      String   @default("opt-in") // opt-in, opt-out, customized
  consentModeState String?  // GCM v2 state snapshot
  tcfVector        String?  // IAB TCF 2.3 vector string if enabled
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([countryCode])
  @@index([consentType])
  @@map("consent_logs")
}

model CookieScanResult {
  id              String   @id @default(cuid())
  domain          String
  cookiesDetected String   @db.Text // JSON string of detected cookies & scripts with categories
  totalTrackers   Int      @default(0)
  scannedAt       DateTime @default(now())

  @@index([scannedAt])
  @@map("cookie_scan_results")
}

model ConsentBannerConfig {
  id                  String   @id @default("default")
  themeColor          String   @default("#166534") // Emerald / Greenwave theme
  layout              String   @default("bottom-bar") // bottom-bar, modal, popup-card
  position            String   @default("bottom")
  defaultLang         String   @default("en")
  consentModeV2       Boolean  @default(true)
  tcfEnabled          Boolean  @default(true)
  geoTargeting        Boolean  @default(true)
  autoBlock           Boolean  @default(true)
  customCss           String?  @db.Text
  updatedAt           DateTime @updatedAt

  @@map("consent_banner_config")
}

model LegalPolicy {
  id          String   @id @default(cuid())
  type        String   @unique // privacy, cookie, terms
  title       String
  content     String   @db.Text
  version     String   @default("1.0.0")
  updatedAt   DateTime @updatedAt

  @@map("legal_policies")
}

