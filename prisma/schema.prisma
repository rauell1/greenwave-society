generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  interest  String   @default("general")
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([interest])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  active           Boolean  @default(true)
  unsubscribeToken String?  @unique @map("unsubscribe_token")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model ExecutiveLeader {
  id         String                  @id @default(cuid())
  name       String
  role       String
  email      String                  @unique
  createdAt  DateTime                @default(now())
  signatures ConstitutionSignature[]

  @@map("executive_leaders")
}

model ConstitutionVersion {
  id          String                  @id @default(cuid())
  versionTag  String
  title       String                  @default("Executive Leadership Constitution")
  content     String                  @db.Text
  contentType String                  @default("html")
  status      String                  @default("draft")
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  signatures  ConstitutionSignature[] @relation("ConstitutionSignatureVersion")

  @@index([status])
  @@map("constitution_versions")
}

model ConstitutionSignature {
  id                  String               @id @default(cuid())
  leaderId            String               @unique
  leader              ExecutiveLeader      @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  versionId           String?
  constitutionVersion ConstitutionVersion? @relation("ConstitutionSignatureVersion", fields: [versionId], references: [id])
  versionTag          String               @default("V1")
  version             String? // legacy text column retained for existing data
  status              String               @default("pending")
  token               String               @unique
  signedAt            DateTime?
  rejectionReason     String?
  ipAddress           String?
  emailSentAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([leaderId])
  @@index([token])
  @@index([status])
  @@map("constitution_signatures")
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actor        String
  actorUserId  String?  @map("actor_user_id")
  detail       String?
  ip           String?
  resourceType String?
  resourceId   String?
  requestId    String?
  outcome      String?
  beforeState  String?  @db.Text
  afterState   String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actor])
  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model AdminSession {
  id               String     @id @default(cuid())
  token            String?    @unique // legacy sessions only; remove after migration window
  tokenHash        String?    @unique @map("token_hash")
  userId           String?
  user             AdminUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent        String?
  ipHash           String?
  createdAt        DateTime   @default(now())
  expiresAt        DateTime
  idleExpiresAt    DateTime?
  revokedAt        DateTime?
  revocationReason String?

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model MemberRegistration {
  id               String           @id @default(cuid())
  fullName         String
  email            String
  phone            String
  county           String
  occupation       String
  organization     String?
  meetsEligibility Boolean          @default(true)
  interests        String[]
  motivation       String           @db.Text
  hearAboutUs      String?
  source           String?
  acknowledged     Boolean          @default(true)
  active           Boolean          @default(true)
  status           String           @default("pending")
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedBy       String?
  memberToken      String?          @unique
  lastSeenAt       DateTime?
  loginCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  activity         MemberActivity[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([memberToken])
  @@map("member_registrations")
}

model MemberActivity {
  id             String             @id @default(cuid())
  registrationId String
  member         MemberRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event          String
  metadata       String?
  createdAt      DateTime           @default(now())

  @@index([registrationId])
  @@index([createdAt])
  @@map("member_activity")
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roles            AdminUserRole[]
  sessions         AdminSession[]
  createdContent   CmsContent[]         @relation("CmsContentCreatedBy")
  updatedContent   CmsContent[]         @relation("CmsContentUpdatedBy")
  contentRevisions CmsContentRevision[] @relation("CmsRevisionCreatedBy")

  @@index([resetToken])
  @@map("admin_users")
}

model CmsContent {
  id          String               @id @default(cuid())
  type        String               @default("page")
  slug        String
  title       String
  excerpt     String?              @db.Text
  body        String               @db.Text
  metadata    String?              @db.Text
  status      String               @default("draft")
  version     Int                  @default(1)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdById String
  updatedById String
  createdBy   AdminUser            @relation("CmsContentCreatedBy", fields: [createdById], references: [id])
  updatedBy   AdminUser            @relation("CmsContentUpdatedBy", fields: [updatedById], references: [id])
  revisions   CmsContentRevision[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([type, slug])
  @@index([status, updatedAt])
  @@index([scheduledAt])
  @@map("cms_content")
}

model CmsContentRevision {
  id          String     @id @default(cuid())
  contentId   String
  content     CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  excerpt     String?    @db.Text
  body        String     @db.Text
  metadata    String?    @db.Text
  status      String
  createdById String
  createdBy   AdminUser  @relation("CmsRevisionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  @@unique([contentId, version])
  @@index([contentId, createdAt])
  @@map("cms_content_revisions")
}

model ConsentLog {
  id               String   @id @default(cuid())
  consentId        String   @unique
  categories       String // JSON string of enabled categories (necessary, analytics, marketing, preferences)
  ipHash           String?
  countryCode      String?  @default("GLOBAL")
  consentType      String   @default("opt-in") // opt-in, opt-out, customized
  consentModeState String? // GCM v2 state snapshot
  tcfVector        String? // IAB TCF 2.3 vector string if enabled
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([countryCode])
  @@index([consentType])
  @@map("consent_logs")
}

model CookieScanResult {
  id              String   @id @default(cuid())
  domain          String
  cookiesDetected String   @db.Text // JSON string of detected cookies & scripts with categories
  totalTrackers   Int      @default(0)
  scannedAt       DateTime @default(now())

  @@index([scannedAt])
  @@map("cookie_scan_results")
}

model ConsentBannerConfig {
  id            String   @id @default("default")
  themeColor    String   @default("#166534") // Emerald / Greenwave theme
  layout        String   @default("bottom-bar") // bottom-bar, modal, popup-card
  position      String   @default("bottom")
  defaultLang   String   @default("en")
  consentModeV2 Boolean  @default(true)
  tcfEnabled    Boolean  @default(true)
  geoTargeting  Boolean  @default(true)
  autoBlock     Boolean  @default(true)
  customCss     String?  @db.Text
  updatedAt     DateTime @updatedAt

  @@map("consent_banner_config")
}

model LegalPolicy {
  id        String   @id @default(cuid())
  type      String   @unique // privacy, cookie, terms
  title     String
  content   String   @db.Text
  version   String   @default("1.0.0")
  updatedAt DateTime @updatedAt

  @@map("legal_policies")
}

model BaazaRegistration {
  id               String   @id @default(cuid())
  fullName         String
  email            String
  phone            String
  organization     String
  role             String
  willAttend       String
  takeaway         String?
  accessNeeds      String?
  invitationSource String?
  photoConsent     Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@map("baraza_registrations")
}

model AdminRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AdminRolePermission[]
  users       AdminUserRole[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUserRole {
  userId String
  roleId String

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model CmsFeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_feature_flags")
}
