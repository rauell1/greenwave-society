generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  interest  String   @default("general")
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([interest])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model ExecutiveLeader {
  id        String                @id @default(cuid())
  name      String
  role      String
  email     String                @unique
  createdAt DateTime              @default(now())
  signature ConstitutionSignature?

  @@map("executive_leaders")
}

model ConstitutionSignature {
  id              String          @id @default(cuid())
  leaderId        String          @unique
  leader          ExecutiveLeader @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  version         String          @default("1.0")
  status          String          @default("pending")
  token           String          @unique
  signedAt        DateTime?
  rejectionReason String?
  ipAddress       String?
  emailSentAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([token])
  @@index([status])
  @@map("constitution_signatures")
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([resetToken])
  @@map("admin_users")
}
