generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  interest  String   @default("general")
  message   String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([interest])
  @@map("contact_submissions")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

model ExecutiveLeader {
  id         String                  @id @default(cuid())
  name       String
  role       String
  email      String                  @unique
  createdAt  DateTime                @default(now())
  signatures ConstitutionSignature[]

  @@map("executive_leaders")
}

model ConstitutionVersion {
  id          String                  @id @default(cuid())
  versionTag  String
  title       String                  @default("Executive Leadership Constitution")
  content     String                  @db.Text
  contentType String                  @default("html")
  status      String                  @default("draft")
  publishedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  signatures  ConstitutionSignature[]

  @@index([status])
  @@map("constitution_versions")
}

model ConstitutionSignature {
  id              String               @id @default(cuid())
  leaderId        String
  leader          ExecutiveLeader      @relation(fields: [leaderId], references: [id], onDelete: Cascade)
  versionId       String?
  version         ConstitutionVersion? @relation(fields: [versionId], references: [id])
  versionTag      String               @default("V1")
  status          String               @default("pending")
  token           String               @unique
  signedAt        DateTime?
  rejectionReason String?
  ipAddress       String?
  emailSentAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([leaderId])
  @@index([token])
  @@index([status])
  @@map("constitution_signatures")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model MemberRegistration {
  id               String           @id @default(cuid())
  fullName         String
  email            String
  phone            String
  county           String
  occupation       String
  organization     String?
  meetsEligibility Boolean          @default(true)
  interests        String[]
  motivation       String           @db.Text
  hearAboutUs      String?
  source           String?
  acknowledged     Boolean          @default(true)
  status           String           @default("pending")
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedBy       String?
  memberToken      String?          @unique
  lastSeenAt       DateTime?
  loginCount       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  activity         MemberActivity[]

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([memberToken])
  @@map("member_registrations")
}

model MemberActivity {
  id             String             @id @default(cuid())
  registrationId String
  member         MemberRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event          String
  metadata       String?
  createdAt      DateTime           @default(now())

  @@index([registrationId])
  @@index([createdAt])
  @@map("member_activity")
}

model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([resetToken])
  @@map("admin_users")
}
