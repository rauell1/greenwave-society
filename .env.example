# Database
DATABASE_URL="file:./db/custom.db"
# Neon: DATABASE_URL should be the pooled (-pooler) connection string for the app's
# normal runtime queries; DIRECT_DATABASE_URL must be the DIRECT (non-pooled, no
# "-pooler" in the hostname) connection string — Prisma Migrate needs a direct
# connection to hold its advisory lock, which Neon's PgBouncer pooler can't support.
# Using the pooled URL for both causes intermittent "P1002: advisory lock" build failures.
# DIRECT_DATABASE_URL="postgresql://...@ep-xxxx.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://greenwavesociety.org"
PORT=3000

# Security
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
CORS_ORIGIN="https://greenwavesociety.org"
SESSION_SECRET="your-secret-key-change-in-production"

# Email (Optional - for future notifications)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# FROM_EMAIL="info@greenwavesociety.org"

# Analytics (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Database
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Admin Dashboard
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_EMAIL="admin@example.com"
EXPORT_PASSWORD="change-this-export-password"
SESSION_SECRET="change-this-to-a-random-32-char-secret-key!!"

# M-Pesa Membership Fee (not live until the "payments.mpesa_membership" CMS
# feature flag is enabled — see docs/mpesa-membership-payments.md)
# FEATURE_MPESA_MEMBERSHIP=true          # force-enable locally without touching the DB flag
# MEMBERSHIP_FEE_KES=500                 # fallback only — the fee is normally set from /admin/settings
# MPESA_ENVIRONMENT="sandbox"            # "sandbox" or "production"
# MPESA_CONSUMER_KEY=""
# MPESA_CONSUMER_SECRET=""
# MPESA_SHORTCODE=""
# MPESA_PASSKEY=""
# MPESA_CALLBACK_URL="https://greenwavesociety.org/api/mpesa/callback"
#
# Refunds (Transaction Reversal) — a separate, more privileged credential set.
# Requires a registered Paybill/Till (not the STK sandbox app alone) and
# Safaricom's public certificate for the environment. See
# docs/mpesa-membership-payments.md for how to obtain these.
# MPESA_INITIATOR_NAME=""
# MPESA_INITIATOR_PASSWORD=""
# MPESA_REVERSAL_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
