{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenwave-society",
  // OpenNext refreshes stale cached pages (revalidate) by calling this Worker
  // through this binding; without it the refresh is skipped and every
  // request renders the page again.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "greenwave-society" }],
  // Wraps .open-next/worker.js and adds the scheduled (cron) handler.
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Run the Worker near its database and APIs rather than near each visitor.
  // Without this, every query from a page in Nairobi would cross to the
  // database region and back, which is slower than Vercel's single region.
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Daily at 05:00 UTC (08:00 EAT): scheduled event emails.
  "triggers": { "crons": ["0 5 * * *"] },
  // Runtime secrets are set with `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  // See .env.example for the full list.
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "greenwavesociety.org", "custom_domain": true },
    { "pattern": "www.greenwavesociety.org", "custom_domain": true }
  ],
  // Pooled connections to the Neon production database. Query caching is off,
  // so reads always see the latest writes. localConnectionString is only for
  // local tooling (wrangler dev, the OpenNext deploy step).
  "hyperdrive": [{
    "binding": "HYPERDRIVE",
    "id": "da4ff0c958bd411aab40870b2d839693",
    "localConnectionString": "postgresql://postgres:postgres@localhost:5432/dev"
  }],
  "observability": { "enabled": true },
  // Resizes site photos for next/image (cloudflare-worker.ts).
  "images": { "binding": "IMAGES" },
  // Page cache for open-next.config.ts. The deploy creates the bucket if it
  // does not exist (the Cloudflare API token needs Workers R2 Storage: Edit).
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "greenwave-next-cache" },
    // Web-sized site photos (cloudflare-worker.ts); HD originals stay in Neon.
    { "binding": "SITE_IMAGES", "bucket_name": "greenwave-site-images" }
  ],
  // Tag cache for revalidatePath/revalidateTag (open-next.config.ts).
  "kv_namespaces": [
    { "binding": "NEXT_TAG_CACHE_KV", "id": "7a8ab3166e384b5ea909637fbe033c9e" }
  ]
}
